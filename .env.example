# Copy to .env for local development and customize safely.
# Never commit real credentials or production secrets.

APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# Local-only ZIDP Keycloak/PostgreSQL development stack.
# Generate unique values; do not reuse production credentials.
ZIDP_BASE_URL=http://127.0.0.1:8080
ZIDP_REALM=zeaz-dev
ZIDP_ADMIN_USERNAME=zidp-local-admin
ZIDP_ADMIN_PASSWORD=
ZIDP_DB_PASSWORD=
